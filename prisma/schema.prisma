generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Customer {
  id           String        @id @default(cuid())
  name         String
  phone        String        @unique
  email        String?
  password     String?       // Müşteri şifresi (Giriş için)
  status       String        @default("PENDING_APPROVAL") // PENDING_APPROVAL (Onay Bekliyor), APPROVED (Onaylandı), REJECTED (Reddedildi)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

model Staff {
  id           String        @id @default(cuid())
  name         String
  title        String        // örn. "Master Berber", "Saç Tasarım Uzmanı"
  phone        String?
  email        String?
  avatarUrl    String?
  color        String        @default("#dc2626") // Takvimde ayırt edici renk (#dc2626, #2563eb, #059669, #d97706)
  startTime    String        @default("09:00")
  endTime      String        @default("20:00")
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

model Service {
  id              String        @id @default(cuid())
  name            String
  category        String        // "Saç Kesimi", "Sakal & Bakım", "Kombin Paket", "Özel Paket", "Renklendirme", "Özel Bakım & Spa"
  durationMinutes Int           @default(35)
  price           Float
  description     String?
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  appointments    Appointment[]
}

model Appointment {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staffId     String
  staff       Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  
  appointmentDate DateTime // Tarih
  dateStr         String   // "YYYY-MM-DD"
  startTime       String   // "10:30"
  endTime         String   // "11:15"
  
  status      String   @default("PENDING") // PENDING (Beklemede), CONFIRMED (Onaylandı), COMPLETED (Tamamlandı), CANCELLED (İptal)
  totalPrice  Float
  notes       String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dateStr])
  @@index([staffId])
  @@index([status])
}
